@model List<Villaalba_Midterm_Store.Models.CartItem>
@{ ViewData["Title"] = "Cart"; }
<h2 class="mb-3">Your Cart</h2>

@foreach (var i in Model)
{
    <div class="card mb-2 shadow-sm">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h5 class="mb-1">@i.ProductName</h5>
                <span class="text-muted">Price: @i.Price.ToString("N2")</span>
            </div>
            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1">
                <input type="hidden" name="id" value="@i.Id" />
                <label class="me-1">Qty:</label>
                <input type="number" name="quantity" value="@i.Quantity" min="1" class="form-control form-control-sm" style="width:80px" />
                <button class="btn btn-outline-primary btn-sm">Update</button>
            </form>
            <div class="fw-bold">Subtotal: @((i.Price * i.Quantity).ToString("N2"))</div>
            <form asp-action="Remove" method="post">
                <input type="hidden" name="id" value="@i.Id" />
                <button class="btn btn-danger btn-sm">Remove</button>
            </form>
        </div>
    </div>
}

@if (!Model.Any()) { <p class="text-muted">Your cart is empty.</p> }

<div class="card mt-3 border-dark">
    <div class="card-body text-end fs-4 fw-bold">
        Total: @Model.Sum(i => i.Price * i.Quantity).ToString("N2")
    </div>
</div>
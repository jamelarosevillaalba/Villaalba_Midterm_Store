@{ ViewData["Title"] = "Welcome"; }

<div class="text-center py-5 bg-light rounded mb-4">
    <h1 class="display-4">Welcome to Sweet Crumbs Bakery</h1>
    <p class="lead">Freshly baked croissants, cookies, muffins, and cakes, made every day.</p>
    <hr class="my-4" />
    <p>Browse our pastries, add your favorites to the cart, and see your total.</p>
    <a class="btn btn-primary btn-lg" asp-controller="Products" asp-action="Index">View Products</a>
    <a class="btn btn-outline-secondary btn-lg" asp-controller="Cart" asp-action="Index">Go to Cart</a>
</div>